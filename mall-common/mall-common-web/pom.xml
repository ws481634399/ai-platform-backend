<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ai-mall</groupId>
    <artifactId>mall-common</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>mall-common-web</artifactId>

  <name>mall-common-web</name>
  <description>Web 层通用能力：统一响应、异常处理、TraceId 过滤器、OpenAPI（版本由 mall-bom 统一管理）</description>

  <dependencies>
    <!-- web→core：统一响应/错误码/TraceContext 等纯 Java 基础（design.md §2.5 依赖方向） -->
    <dependency>
      <groupId>com.ai-mall</groupId>
      <artifactId>mall-common-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- WebMVC 增强层基座（排除 WebFlux 栈使用，gateway 禁止依赖本模块） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- OpenAPI 文档：版本由 mall-bom 统一管理，服务依赖本模块即传递获得 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <!-- 仅测试 classpath 生效（@WebMvcTest 切片测试） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
