<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ai-mall</groupId>
    <artifactId>mall-services</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>mall-cart</artifactId>

  <name>mall-cart</name>
  <description>购物车服务：会员购物车 Redis 写模型、实时校验与游客合并</description>

  <dependencies>
    <!-- WebMVC + 统一响应/异常/TraceId/OpenAPI（经 mall-common-web 传递，版本经 mall-bom） -->
    <dependency>
      <groupId>com.ai-mall</groupId>
      <artifactId>mall-common-web</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 日志基础配置资产（logback/mall-logback-base.xml 随 jar 提供） -->
    <dependency>
      <groupId>com.ai-mall</groupId>
      <artifactId>mall-common-log</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- CHG-0018 安全：JWT 资源服务器 + JwtSubjectConverter/InternalIdentityFilter -->
    <dependency>
      <groupId>com.ai-mall</groupId>
      <artifactId>mall-common-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- CHG-0018：购物车写模型基于 Redis（Lua 原子写 + 滑动 TTL），服务无 RDBMS 数据源 -->
    <dependency>
      <groupId>com.ai-mall</groupId>
      <artifactId>mall-common-redis</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- CHG-0022：功能开关统一访问（FeatureGate，mall.guest-cart.enabled 切点） -->
    <dependency>
      <groupId>com.ai-mall</groupId>
      <artifactId>mall-common-config</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Nacos 服务发现预留：默认关闭（NACOS_ENABLED:false），禁启动断言（design.md §2.6） -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>
    <!-- 测试依赖聚合器：test scope 引用，传递 JUnit5/AssertJ/Mockito（design.md §2.8） -->
    <dependency>
      <groupId>com.ai-mall</groupId>
      <artifactId>mall-common-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- CHG-0018：Lua 脚本真实 Redis 集成测试（Testcontainers，版本由 Boot BOM 托管） -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 可执行 Fat Jar：独立打包与启动 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 本地离线环境无 testcontainers/ryuk 镜像：容器清理由 JVM shutdown hook 兜底 -->
          <environmentVariables>
            <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
